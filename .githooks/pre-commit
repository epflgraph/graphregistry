#!/usr/bin/env bash
#
# pre-commit hook — refuses commits that add credentials to staged changes.
#
# Runs in EVERY git client (terminal, VS Code, JetBrains, GitHub Desktop...):
# if gitleaks finds a secret in the staged diff, the commit is aborted and the
# findings are printed where the client displays hook output (in VS Code: the
# Git output panel / the toast shown when a commit fails).
#
# One-time setup per clone:   git config core.hooksPath .githooks
#
# False positive?  Add an entry to the [[allowlists]] blocks in .gitleaks.toml,
# or put `# gitleaks:allow` on the offending line.
#
# If gitleaks itself is unavailable the scan is SKIPPED with a loud warning
# (fail-open). Set GITLEAKS_HOOK_FAIL_CLOSED=1 (env) to refuse commits instead.

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$REPO_ROOT" || exit 0

# GUI clients may spawn git with a minimal PATH — resolve gitleaks robustly.
GITLEAKS="$(command -v gitleaks 2>/dev/null || true)"
if [ -z "$GITLEAKS" ]; then
    for candidate in "$HOME/.local/bin/gitleaks" /usr/local/bin/gitleaks /usr/bin/gitleaks /opt/homebrew/bin/gitleaks; do
        if [ -x "$candidate" ]; then GITLEAKS="$candidate"; break; fi
    done
fi

if [ -z "$GITLEAKS" ]; then
    {
        echo "------------------------------------------------------------------"
        echo "⚠️  pre-commit secret scan SKIPPED: 'gitleaks' was not found."
        echo "    Install it (https://github.com/gitleaks/gitleaks) or make sure"
        echo "    it is on PATH for GUI-launched apps (e.g. ~/.local/bin)."
        if [ "${GITLEAKS_HOOK_FAIL_CLOSED:-0}" = "1" ]; then
            echo "    Commit REFUSED (GITLEAKS_HOOK_FAIL_CLOSED=1)."
            echo "------------------------------------------------------------------"
            exit 1
        fi
        echo "    Commit allowed this time — do not rely on this."
        echo "------------------------------------------------------------------"
    } >&2
    exit 0
fi

# Scan ONLY the staged diff (fast, ~1s). Findings are redacted; the full
# repository triage lives in ./scan.sh.
"$GITLEAKS" git --pre-commit --staged \
    --config "$REPO_ROOT/.gitleaks.toml" \
    --redact --no-banner 1>&2
rc=$?

if [ "$rc" -eq 0 ]; then
    exit 0
fi

{
    echo ""
    echo "──────────────────────────────────────────────────────────────────"
    echo "🚨 COMMIT REFUSED — possible credential(s) in the staged changes"
    echo "──────────────────────────────────────────────────────────────────"
    echo "  The commit was NOT created. What to do:"
    echo ""
    echo "   • Real credential  → remove it from the code (load it from"
    echo "     .env / gitignored config instead) and rotate it if it was"
    echo "     ever pushed anywhere."
    echo "   • False positive   → add an [[allowlists]] entry in"
    echo "     .gitleaks.toml, or put '# gitleaks:allow' on the line."
    echo "   • Then stage the fix and commit again."
    echo ""
    echo "   • Emergency bypass (discouraged): 'git commit --no-verify' —"
    echo "     CI will still scan the pushed history."
    echo "──────────────────────────────────────────────────────────────────"
} >&2
exit 1
