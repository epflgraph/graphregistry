-- ============================================================================
-- Formula: downstream_hard_delete
-- Purpose: Physically remove rows already marked as soft-deleted (deleted = 1)
--          from graph_airflow and graph_cache tables.
-- Note: graphsearch_test and elasticsearch_cache do not have delete flags.
-- ============================================================================

-- ----------------------------------------------------------------------------
-- graph_airflow
-- ----------------------------------------------------------------------------
DELETE FROM [[airflow]].Operations_N_Object_T_FieldsChanged          WHERE deleted = 1;
DELETE FROM [[airflow]].Operations_N_Object_N_Object_T_FieldsChanged WHERE deleted = 1;
DELETE FROM [[airflow]].Operations_N_Object_T_ScoresExpired          WHERE deleted = 1;

-- ----------------------------------------------------------------------------
-- graph_cache: Object-level data tables
-- ----------------------------------------------------------------------------
DELETE FROM [[graph_cache]].Data_N_Object_T_PageProfile      WHERE deleted = 1;
DELETE FROM [[graph_cache]].Data_N_Object_T_AllFields        WHERE deleted = 1;
DELETE FROM [[graph_cache]].Data_N_Object_T_CalculatedFields WHERE deleted = 1;

-- ----------------------------------------------------------------------------
-- graph_cache: Object-object symmetric data tables
-- ----------------------------------------------------------------------------
DELETE FROM [[graph_cache]].Data_N_Object_N_Object_T_AllFieldsSymmetric WHERE deleted = 1;
DELETE FROM [[graph_cache]].Data_N_Object_N_Object_T_CalculatedFields   WHERE deleted = 1;

-- ----------------------------------------------------------------------------
-- graph_cache: Object-ontology edge tables
-- ----------------------------------------------------------------------------
DELETE FROM [[graph_cache]].Edges_N_Object_N_Concept_T_CalculatedScores     WHERE deleted = 1;
DELETE FROM [[graph_cache]].Edges_N_Object_N_Concept_T_FinalScores          WHERE deleted = 1;
DELETE FROM [[graph_cache]].Edges_N_Object_N_Concept_T_ScoringMatrix        WHERE deleted = 1;
DELETE FROM [[graph_cache]].Edges_N_Object_N_Concept_T_UnionAllScores       WHERE deleted = 1;

DELETE FROM [[graph_cache]].Edges_N_Object_N_Category_T_CalculatedScores    WHERE deleted = 1;
DELETE FROM [[graph_cache]].Edges_N_Object_N_Category_T_FinalScores         WHERE deleted = 1;

DELETE FROM [[graph_cache]].Edges_N_Object_N_CuratedArea_T_CalculatedScores WHERE deleted = 1;
DELETE FROM [[graph_cache]].Edges_N_Object_N_CuratedArea_T_FinalScores      WHERE deleted = 1;

-- ----------------------------------------------------------------------------
-- graph_cache: Node degree scores
-- ----------------------------------------------------------------------------
DELETE FROM [[graph_cache]].Nodes_N_Object_T_DegreeScores WHERE deleted = 1;

-- ----------------------------------------------------------------------------
-- graph_cache: Object-object edge tables
-- ----------------------------------------------------------------------------
DELETE FROM [[graph_cache]].Edges_N_Object_N_Object_T_DegreeCombinations   WHERE deleted = 1;
DELETE FROM [[graph_cache]].Edges_N_Object_N_Object_T_NormLogDegrees       WHERE deleted = 1;
DELETE FROM [[graph_cache]].Edges_N_Object_N_Object_T_ParentChildSymmetric WHERE deleted = 1;

DELETE FROM [[graph_cache]].Edges_N_Object_N_Object_T_ScoresMatrix_Education_AS  WHERE deleted = 1;
DELETE FROM [[graph_cache]].Edges_N_Object_N_Object_T_ScoresMatrix_Education_GBC WHERE deleted = 1;
DELETE FROM [[graph_cache]].Edges_N_Object_N_Object_T_ScoresMatrix_Ontology_AS   WHERE deleted = 1;
DELETE FROM [[graph_cache]].Edges_N_Object_N_Object_T_ScoresMatrix_Ontology_GBC  WHERE deleted = 1;
DELETE FROM [[graph_cache]].Edges_N_Object_N_Object_T_ScoresMatrix_Research_AS   WHERE deleted = 1;
DELETE FROM [[graph_cache]].Edges_N_Object_N_Object_T_ScoresMatrix_Research_GBC  WHERE deleted = 1;
